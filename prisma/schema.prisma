// MelMint — Prisma Schema
// Database: MySQL
//
// Models: Wallet, Transaction, SavingsGoal, Cycle, Setting
// Two wallets: "Setup Fund" (backup) and "Salary Account" (active income)
// Cycles are salary-triggered fortnightly periods
// Settings stores expense_limit and fixed_rent as key-value pairs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Wallet {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(100)
  balance     Decimal       @default(0) @db.Decimal(12, 2)
  description String?       @db.VarChar(255)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id              Int             @id @default(autoincrement())
  date            DateTime
  transactionType TransactionType @map("transaction_type")
  category        String          @db.VarChar(100)
  paymentMethod   String          @map("payment_method") @db.VarChar(100)
  description     String          @db.VarChar(255)
  amount          Decimal         @db.Decimal(12, 2)

  walletId        Int             @map("wallet_id")
  wallet          Wallet          @relation(fields: [walletId], references: [id])

  cycleId         Int?            @map("cycle_id")
  cycle           Cycle?          @relation(fields: [cycleId], references: [id])

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([date])
  @@index([transactionType])
  @@index([category])
  @@index([walletId])
  @@index([cycleId])
  @@map("transactions")
}

model SavingsGoal {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(150)
  targetAmount Decimal  @default(0) @map("target_amount") @db.Decimal(12, 2)
  savedAmount  Decimal  @default(0) @map("saved_amount") @db.Decimal(12, 2)
  percentage   Int      @default(0)
  priority     Int      @default(1) // 1 = highest importance, higher = lower importance
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contributions SavingsContribution[]

  @@map("savings_goals")
}


model Cycle {
  id             Int       @id @default(autoincrement())
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  salaryAmount   Decimal   @map("salary_amount") @db.Decimal(12, 2)
  expenseLimit   Decimal   @map("expense_limit") @db.Decimal(12, 2)
  rolloverAmount Decimal   @default(0) @map("rollover_amount") @db.Decimal(12, 2)
  status         String    @default("ACTIVE") @db.VarChar(20)
  cycleNotes     String?   @map("cycle_notes") @db.Text

  transactions   Transaction[]
  contributions  SavingsContribution[]

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([startDate])
  @@map("cycles")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique @db.VarChar(100)
  value String @db.VarChar(255)

  @@map("settings")
}

model SavingsContribution {
  id        Int         @id @default(autoincrement())
  amount    Decimal     @db.Decimal(12, 2)
  source    String      @db.VarChar(50) // "salary_allocation", "rollover", "overspend_deduction", "manual"

  cycleId   Int         @map("cycle_id")
  cycle     Cycle       @relation(fields: [cycleId], references: [id])

  goalId    Int         @map("goal_id")
  goal      SavingsGoal @relation(fields: [goalId], references: [id])

  createdAt DateTime    @default(now()) @map("created_at")

  @@index([cycleId])
  @@index([goalId])
  @@map("savings_contributions")
}
